{
  "name": "pixel-realtime",
  "version": "2.0.0",
  "description": "TypeScript client package foundation for Pixel realtime features.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pixel-Softwares-com/Pixel-frontend-realtime.git"
  },
  "bugs": {
    "url": "https://github.com/Pixel-Softwares-com/Pixel-frontend-realtime/issues"
  },
  "homepage": "https://github.com/Pixel-Softwares-com/Pixel-frontend-realtime#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.5"
  }
}
